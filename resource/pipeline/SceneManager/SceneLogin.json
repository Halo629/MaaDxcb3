{
	"LaunchAndEntryGame": {
		"desc": "启动游戏并进入游戏",
		"recognition": "DirectHit",
		"post_delay": 0,
		"pre_delay": 0,
		"action": "Custom",
		"custom_action": "SubTask",
		"custom_action_param": {
			"sub": ["ServerConfigStart"]
		},
		"next": [
			"[JumpBack]SwitchServer",
			"LoginPageClickStartGameButton",
			"[JumpBack]LoginPageEventsHandle",
			"InGameCheck",
			"[JumpBack]LaunchGame"
		],
		"on_error": [
			"RestartGameAndRetry"
		]
	},
	"ServerConfigStart": {
		"desc": "用户配置保存入口",
		"recognition": "DirectHit",
		"action": "Custom",
		"custom_action": "SaveConfig"
	},
	"SwitchServer": {
		"desc": "切换服务器",
		"enabled": false,
		"max_hit": 1,
		"next": [
			"CheckTargetServerIfInGame",
			"InTargetServer",
			"SwitchToTargetServer",
			"[JumpBack]LoginPageEventsHandle",
			"[JumpBack]SwitchServerRestartGame",
			"[JumpBack]LaunchGame"
		],
		"post_delay": 0,
		"pre_delay": 0,
		"rate_limit": 0
	},
	"SwitchServerRestartGame": {
		"desc": "重启游戏",
		"max_hit": 1,
		"recognition": "Or",
		"any_of": ["InLoginPage", "InGameCheck"],
		"action": "Custom",
		"custom_action": "SubTask",
		"custom_action_param": {
			"sub": ["QuitGame", "LaunchGame"]
		}
	},
	"SwitchToTargetServer": {
		"desc": "切换到目标服务器",
		"recognition": "And",
		"all_of": ["InLoginPage", "LoginPageHasStartGameButton"],
		"next": [
			"FindAndSwitchServerInServerList",
			"[JumpBack]LoginSettingPageEntryServerListPage",
			"[JumpBack]LoginPageEnterSettingPage"
		]
	},
	"CustomServerList": {
		"recognition": "And",
		"all_of": [
			{
				"recognition": "OCR",
				"expected": "灵魂连接等级|等级",
				"roi": [107, 309, 295, 644],
				"sub_name": "LevelPos"
			},
			{
				"recognition": "ColorMatch",
				"method": 40,
				"lower": [15, 150, 150],
				"upper": [20, 170, 220],
				"roi": "LevelPos",
				"roi_offset": [-6, -61, 117, 35],
				"count": 100,
				"sub_name": "ServerColor"
			},
			{
				"recognition": "OCR",
				"roi": "ServerColor",
				"roi_offset": [-2, -2, 4, 4],
				"only_rec": true,
				"order_by": "Vertical",
				"sub_name": "ServerName"
			}
		]
	},
	"CustomCurrentServerName": {
		"desc": "识别当前服务器(自定义识别使用)",
		"post_delay": 0,
		"pre_delay": 0,
		"recognition": "And",
		"all_of": [
			{
				"recognition": "ColorMatch",
				"method": 40,
				"lower": [0, 0, 40],
				"upper": [30, 20, 160],
				"roi": [13, 1224, 263, 30],
				"count": 100,
				"sub_name": "LoginPageServerColor"
			},
			{
				"recognition": "OCR",
				"roi": "LoginPageServerColor",
				"roi_offset": [-2, -2, 4, 4],
				"only_rec": true,
				"sub_name": "LoginPageServerName"
			}
		]
	},
	"CheckTargetServerIfInGame": {
		"desc": "在游戏中检查当前服务器是否是目标服务器",
		"max_hit": 1,
		"recognition": "And",
		"all_of": ["InGameCheck"],
		"next": [
			"CheckTargetServerInGame",
			"[JumpBack]SceneEnterPersonalInfoPage",
			"InGameCheckTargetServerFail"
		]
	},
	"InGameCheckTargetServerFail": {
		"desc": "在游戏中检查目标服务器失败,重置SwitchServer计数并重新走切换服务器逻辑",
		"action": "Custom",
		"custom_action": "ClearHitCount",
		"custom_action_param": {
			"nodes": ["SwitchServer"]
		},
		"next": [
			"SwitchServer"
		]
	},
