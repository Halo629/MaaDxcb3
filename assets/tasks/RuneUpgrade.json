{
	"task": [
		{
			"name": "RuneUpgrade",
			"label": "🔣升级符文",
			"description": "需解锁破碎之境快速挑战",
			"entry": "ShatteredRealmStart",
			"group": ["other_tasks"],
			"option": [
				"QuickChallengeCount",
				"UseMagnetLevel",
				"AutoUnlockRune",
				"SelectUpgradeRune"
			],
			"pipeline_override": {
				"ShatteredRealmRuneUpgradeStart": {"enabled": true}
			}
		}
	],
	"option": {
		"QuickChallengeCount": {
			"type": "select",
			"label": "升级前快速挑战破碎之境次数",
			"default_case": "MaxCount",
			"cases": [
				{
					"name": "MaxCount",
					"label": "最大次数",
					"description": "将消耗所有异域古虫进行快速挑战"
				},
				{
					"name": "SpecifiedCount",
					"label": "指定次数",
					"option": ["SpecifiedCountValue"]
				}
			]
		},
		"SpecifiedCountValue": {
			"type": "input",
			"label": "指定次数",
			"inputs": [
				{
					"name": "SpecifiedCountInputValue",
					"label": "输入次数",
					"pipeline_type": "int",
					"default": "50",
					"verify": "^\\d+$",
					"pattern_msg": "次数需为大于等于 0 的整数"
				}
			],
			"pipeline_override": {
				"ShatteredRealmQuickChallenge": {"max_hit": "{SpecifiedCountInputValue}"}
			}
		},
		"UseMagnetLevel": {
			"type": "input",
			"label": "使用塔莱辛磁石等级",
			"inputs": [
				{
					"name": "UseMagnetLevelValue",
					"label": "多少级开始使用塔莱辛磁石",
					"pipeline_type": "string",
					"default": "38",
					"verify": "^([1-9]|[1-4][0-9])$",
					"pattern_msg": "等级需在 1 到 49 之间"
				}
			],
			"pipeline_override": {
				"RuneLevelBelowMagnetLevel": {
					"custom_recognition_param": {
						"expression": "{RuneLevelInUpgradePage}<{target}",
						"params": {
							"target": "{UseMagnetLevelValue}"
						}
					}
				},
				"RuneLevelReachMagnetLevel": {
					"custom_recognition_param": {
						"expression": "{RuneLevelInUpgradePage}>={target}",
						"params": {
							"target": "{UseMagnetLevelValue}"
						}
					}
				}
			}
		},
