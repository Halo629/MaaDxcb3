{
	"task": [
		{
			"name": "ReforgeEquipment",
			"label": "⚒️重铸装备",
			"description": "自动重铸装备",
			"entry": "EquipmentReforgeStart",
			"pipeline_override": {
				"EquipmentReforgeStart": {"enabled": true},
				"ReforgeToTargetStart": {"enabled": true}
			},
			"group": ["other_tasks"],
			"option": [
				"WeaponReforgeTarget",
				"ArmorReforgeTarget",
				"ReforgeTargetRole"
			]
		}
	],
	"option": {
		"WeaponReforgeTarget": {
			"type": "input",
			"label": "武器重铸目标完美度",
			"inputs": [
				{
					"name": "WeaponReforgeTargetValue",
					"label": "输入重铸目标完美度，支持小数点",
					"pipeline_type": "string",
					"default": "99",
					"verify": "^(9[0-9](\\.[0-9]+)?|100(\\.0+)?)$",
					"pattern_msg": "重铸目标完美度需在 90 到 100 之间"
				}
			],
			"pipeline_override": {
				"WeaponReforgeQualified": {
					"custom_recognition_param": {
						"expression": "{ReforgeValue}>={target}",
						"params": {
							"target": "{WeaponReforgeTargetValue}"
						}
					}
				}
			}
		},
		"ArmorReforgeTarget": {
			"type": "input",
			"label": "防具重铸目标完美度",
			"inputs": [
				{
					"name": "ArmorReforgeTargetValue",
					"label": "输入重铸目标完美度，支持小数点",
					"pipeline_type": "string",
					"default": "95",
					"verify": "^(9[0-9](\\.[0-9]+)?|100(\\.0+)?)$",
					"pattern_msg": "重铸目标完美度需在 90 到 100 之间"
				}
			],
			"pipeline_override": {
				"ArmorReforgeQualified": {
					"custom_recognition_param": {
						"expression": "{ReforgeValue}>={target}",
						"params": {
							"target": "{ArmorReforgeTargetValue}"
						}
					}
				}
			}
		},
		"ReforgeTargetRole": {
			"type": "checkbox",
			"label": "选择需要重铸的人物，从左往右，前排1,2,3，后排4,5,6",
			"default_case": [
				"FirstRole",
				"SecondRole",
				"ThirdRole",
				"FourthRole",
				"FifthRole",
				"SixthRole"
			],
			"cases": [
				{
					"name": "FirstRole",
					"label": "1号位",
					"pipeline_override": {
						"FirstRoleEquipmentReforge": {"enabled": true}
					}
				},
				{
					"name": "SecondRole",
					"label": "2号位",
					"pipeline_override": {
						"SecondRoleEquipmentReforge": {"enabled": true}
					}
				},
				{
					"name": "ThirdRole",
					"label": "3号位",
					"pipeline_override": {
						"ThirdRoleEquipmentReforge": {"enabled": true}
					}
				},
				{
					"name": "FourthRole",
					"label": "4号位",
					"pipeline_override": {
						"FourthRoleEquipmentReforge": {"enabled": true}
					}
				},
				{
					"name": "FifthRole",
					"label": "5号位",
					"pipeline_override": {
						"FifthRoleEquipmentReforge": {"enabled": true}
					}
				},
				{
					"name": "SixthRole",
					"label": "6号位",
					"pipeline_override": {
						"SixthRoleEquipmentReforge": {"enabled": true}
					}
				}
			]
		}
	}
}
