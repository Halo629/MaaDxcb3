						"SupremeCourtSilverFarm": {"enabled": true}
					}
				},
				{
					"name": "WildBullValley",
					"label": "蛮牛谷-蛮牛谷军营",
					"pipeline_override": {
						"WildBullValleySilverFarm": {"enabled": true}
					}
				}
			]
		},
		"FarmCount": {
			"type": "input",
			"label": "刷取次数",
			"inputs": [
				{
					"name": "FarmCountInputValue",
					"label": "输入次数",
					"pipeline_type": "int",
					"verify": "^\\d+$",
					"default": "100"
