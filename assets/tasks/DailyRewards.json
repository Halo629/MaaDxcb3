{
    "task": [
        {
            "name": "DailyRewards",
            "label": "🎁日常奖励领取",
            "entry": "DailyRewardsStart",
            "option": [
                "DailyRewardsEmailSub",
                "DailyFreeJade",
                "MonthlyCard",
                "DailyTreasureShop",
                "GuildChallenge",
                "MonsterSoul"
            ],
            "group": [
                "daily_tasks"
            ]
        }
    ],
    "option": {
        "DailyRewardsEmailSub": {
            "type": "switch",
            "label": "领取邮件",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsEmailSub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsEmailSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyFreeJade": {
            "type": "switch",
            "label": "每日免费玉领取",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsFreeJadeSub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsFreeJadeSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "MonthlyCard": {
            "type": "switch",
            "label": "月卡领取",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsMonthlyCardCollectSub": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "AutoBuyMonthlyCard",
                        "AutoUseAdvancedCard"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsMonthlyCardCollectSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
       
        "AutoBuyMonthlyCard": {
            "type": "switch",
            "label": "基础月卡到期自动购买",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "BasicMonthlyCardBuyEntry": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "BasicMonthlyCardBuyEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "AutoUseAdvancedCard": {
            "type": "switch",
            "label": "进阶月卡到期自动使用背包中的进阶月卡(炬火服专属)",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AdvancedMonthlyCardBuyEntry": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AdvancedMonthlyCardBuyEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyTreasureShop": {
            "type": "switch",
            "label": "珍藏商店购买招魂师卷轴",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsTreasureShopSub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsTreasureShopSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "GuildChallenge": {
            "type": "switch",
            "label": "公会挑战&购买",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsGuildSub": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "GuildShopBuyScroll"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsGuildSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "GuildShopBuyScroll": {
            "type": "switch",
            "label": "公会商店购买招魂师卷轴",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "GuildShop": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "GuildShop": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "MonsterSoul": {
            "type": "switch",
            "label": "魔物之魂",
