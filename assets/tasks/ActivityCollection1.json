{
	"task": [
		{
			"name": "GloryRecast",
			"label": "🔥荣光复铸",
			"entry": "GloryRecastStart",
			"group": ["activity_tasks"],
			"option": [
				"ActivityCollection1SoulTomb",
				"ActivityCollection1Engrave",
				"ActivityCollection1Reforge",
				"RetraceBanquetUseScroll"
			]
		},
		{
			"name": "MoonlitBallad",
			"label": "🥮桂影长歌",
			"entry": "MoonlitBalladStart",
			"group": ["activity_tasks"],
			"option": [
				"ActivityCollection1SoulTomb",
				"ActivityCollection1Engrave",
				"ActivityCollection1Reforge",
				"RetraceBanquetUseScroll"
			]
		},
		{
			"name": "OathOfStarryNight",
			"label": "🌌星夜之约",
			"entry": "OathOfStarryNightStart",
			"group": ["activity_tasks"],
			"option": [
				"ActivityCollection1UseFood",
				"ActivityCollection1Engrave"
			]
		}
	],
	"option": {
		"ActivityCollection1Scroll": {
			"type": "switch",
			"label": "唤灵之典卷轴召唤10次",
			"default_case": "No",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"ActivityCommonUseScrollSub": {"enabled": true},
						"ScrollTen": {"enabled": true}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ActivityCommonUseScrollSub": {"enabled": false},
						"ScrollTen": {"enabled": false}
					}
				}
			]
		},
		"ActivityCollection1Reforge": {
			"type": "switch",
			"label": "装备重铸10次",
			"description":"仅选择1号位人物装备，从头依次尝试，重铸满足次数后退出",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"ReforgeTaskStart": {"enabled": true},
						"FirstRoleEquipmentReforge": {"enabled": true},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"ReforgeEquipmentEnable": true}
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ReforgeTaskStart": {"enabled": false},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"ReforgeEquipmentEnable": false}
						}
					}
				}
			]
		},
		"ActivityCollection1Engrave": {
			"type": "switch",
			"label": "铭刻装备2次",
			"description": "优先铭刻黄色装备，可选黄色腐蚀液不足时铭刻绿色装备",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"EngraveEquipmentEnable": true}
						},
						"EngraveBtn": {"max_hit": 2}
					},
					"option": ["EngraveGreenEquipment"]
				},
				{
					"name": "No",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"EngraveEquipmentEnable": false}
						}
					}
				}
			]
		},
		"ActivityCollection1UseFood": {
			"type": "switch",
			"label": "使用食物",
			"description": "只会使用可生产的食物",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"UseFoodEnable": true}
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"UseFoodEnable": false}
						}
					}
				}
			]
		},
		"ActivityCollection1SoulTomb": {
			"type": "switch",
			"label": "挑战2次魂墓",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"AdjustSoulTombStartLevel": {
							"attach": {"target_level": "current"}
						},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"SoulTombEnable": true}
						},
						"BattleAI": {
							"attach": {"quit_immediately": true}
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"SoulTombEnable": false}
						}
					}
				}
			]
		}
	}
}
