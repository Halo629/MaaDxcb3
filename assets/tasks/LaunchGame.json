{
    "task": [
        {
            "name": "LaunchGame",
            "label": "🎮启动游戏",
            "entry": "LaunchAndEntryGame",
            "option": [
                "SwitchToTargetServer",
                "BattleConfig",
                "MonsterSoulUpgradeConfig"
            ],
            "group": [
                "pre_tasks"
            ]
        }
    ],
    "option": {
        "SwitchToTargetServer": {
            "type": "switch",
            "label": "切换到指定服务器",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SwitchServer": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "TargetServerName",
                        "TargetServerLine"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SwitchServer": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "TargetServerName": {
            "type": "input",
            "label": "目标服务器名称",
            "inputs": [
                {
                    "name": "TargetServerNameValue",
                    "label": "服务器名称",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "FindTargetServer": {
                    "attach": {
                        "target_server_name": "{TargetServerNameValue}"
                    }
                },
                "InTargetServer": {
                    "attach": {
                        "target_server_name": "{TargetServerNameValue}"
                    }
                }
            }
        },
        "TargetServerLine": {
            "type": "input",
            "label": "目标服务器线路",
            "inputs": [
                {
                    "name": "TargetServerLineValue",
                    "label": "服务器线路",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "FindTargetServer": {
                    "attach": {
                        "target_server_line": "{TargetServerLineValue}"
                    }
                },
                "InTargetServer": {
                    "attach": {
                        "target_server_line": "{TargetServerLineValue}"
                    }
                }
            }
        },
        "ReserveBean": {
            "type": "input",
            "label": "保留豆子数量",
            "inputs": [
                {
                    "name": "ReserveBeanValue",
                    "label": "数量",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "3"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "reserve": "{ReserveBeanValue}"
                    }
                }
            }
        },
        "CryInterval": {
            "type": "input",
            "label": "战吼间隔",
            "inputs": [
                {
                    "name": "CryIntervalValue",
                    "label": "间隔 (秒)",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "4"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "cry_interval": "{CryIntervalValue}"
                    }
                }
            }
        },
        "BurstSeconds": {
            "type": "input",
            "label": "爆发时间",
            "inputs": [
                {
                    "name": "BurstSecondsValue",
                    "label": "时间 (秒)",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "10"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "burst_seconds": "{BurstSecondsValue}"
                    }
                }
            }
        },
        "CryColumn": {
            "type": "select",
            "label": "战吼列",
            "default_case": "Column2",
            "cases": [
                {
                    "name": "Column1",
                    "label": "第1列",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "cry_column": "Column1"
                            }
                        }
                    }
                },
                {
                    "name": "Column2",
                    "label": "第2列",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "cry_column": "Column2"
                            }
                        }
                    }
                },
                {
                    "name": "Column3",
                    "label": "第3列",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "cry_column": "Column3"
                            }
                        }
                    }
                }
            ]
        },
        "Skill": {
            "type": "select",
            "label": "技能",
            "default_case": "Xiaoqing",
            "cases": [
                {
                    "name": "None",
                    "label": "无",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "skill": "None"
                            }
                        }
                    }
                },
                {
                    "name": "Xiaoqing",
                    "label": "小青",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "skill": "Xiaoqing"
                            }
                        }
                    }
                }
            ]
        },
        "FirstSkillTime": {
            "type": "input",
            "label": "首次技能时机",
            "inputs": [
                {
                    "name": "FirstSkillTimeValue",
                    "label": "时机 (秒)",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "6"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "first_skill_time": "{FirstSkillTimeValue}"
                    }
                }
            }
        },
        "UpgradeCountMode": {
            "type": "select",
            "label": "升级次数",
            "default_case": "MaxCount",
            "cases": [
                {
                    "name": "MaxCount",
                    "label": "最大次数",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "countMode": "0"
                            }
                        }
                    }
                },
                {
                    "name": "SpecifiedCount",
                    "label": "指定次数",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "countMode": "1"
                            }
                        }
                    },
                    "option": [
                        "UpgradeCountValue"
                    ]
                }
            ]
        },
        "UpgradeCountValue": {
            "type": "input",
            "label": "指定次数",
            "inputs": [
                {
                    "name": "UpgradeCountValueInput",
                    "label": "次数",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "20"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "count": "{UpgradeCountValueInput}"
                    }
                }
            }
        },
        "UpgradeSouls": {
