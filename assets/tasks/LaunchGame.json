            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "group1_damage": "{Group1DamageValue}"
                    }
                }
            }
        },
        "Group1Resist": {
            "type": "input",
            "label": "抗性阈值",
            "inputs": [
                {
                    "name": "Group1ResistValue",
                    "label": "抗性 ≥ (%)",
                    "pipeline_type": "string",
                    "default": "0"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "group1_resist": "{Group1ResistValue}"
                    }
                }
            }
        },
        "RetentionGroup2": {
            "type": "switch",
            "label": "保留条件组2",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "retention_group2_enabled": true
                            }
                        }
                    },
                    "option": [
                        "Group2Conditions",
                        "Group2Interval",
