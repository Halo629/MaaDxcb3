        "Group3Conditions": {
            "type": "checkbox",
            "label": "组3条件",
            "default_case": [
                "Interval",
                "Heal"
            ],
            "cases": [
                {
                    "name": "Interval",
                    "label": "间隔",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "g3_interval": true
                            }
                        }
                    }
                },
                {
                    "name": "Heal",
                    "label": "治疗效果",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "g3_heal": true
                            }
                        }
                    }
