        "RetentionGroup1": {
            "type": "switch",
            "label": "保留条件组1",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "retention_group1_enabled": true
                            }
                        }
                    },
                    "option": [
                        "Group1Conditions",
                        "Group1Interval",
                        "Group1Damage",
                        "Group1Resist"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "retention_group1_enabled": false
                            }
                        }
                    }
                }
            ]
        },
        "Group1Conditions": {
            "type": "checkbox",
            "label": "组1条件",
            "default_case": [
                "Interval",
                "Damage"
            ],
            "cases": [
                {
                    "name": "Interval",
                    "label": "间隔",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "g1_interval": true
                            }
                        }
                    }
                },
                {
                    "name": "Damage",
                    "label": "承伤",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "g1_damage": true
                            }
                        }
                    }
                },
                {
                    "name": "Resist",
                    "label": "抗性",
                    "pipeline_override": {
                        "ServerConfigStart": {
                            "attach": {
                                "g1_resist": true
                            }
                        }
                    }
                }
            ]
        },
        "Group1Interval": {
            "type": "input",
            "label": "间隔阈值",
            "inputs": [
                {
                    "name": "Group1IntervalValue",
                    "label": "间隔 ≥ (%)",
                    "pipeline_type": "string",
                    "default": "3"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "group1_interval": "{Group1IntervalValue}"
                    }
                }
            }
        },
        "Group1Damage": {
            "type": "input",
            "label": "承伤阈值",
            "inputs": [
                {
                    "name": "Group1DamageValue",
                    "label": "承伤 ≥ (%)",
                    "pipeline_type": "string",
                    "default": "5"
