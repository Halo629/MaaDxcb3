                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "group2_crit": "{Group2CritValue}"
                    }
                }
            }
        },
        "RetentionGroup3": {
            "type": "switch",
            "label": "保留条件组3",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ServerConfigStart": {
