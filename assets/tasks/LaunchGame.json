                {
                    "name": "Group3HealValue",
                    "label": "治疗效果 ≥ (%)",
                    "pipeline_type": "string",
                    "default": "5"
                }
            ],
            "pipeline_override": {
                "ServerConfigStart": {
                    "attach": {
                        "group3_heal": "{Group3HealValue}"
                    }
                }
            }
        },
        "BattleConfig": {
            "type": "switch",
            "label": "战斗配置",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "ReserveBean",
                        "CryInterval",
                        "BurstSeconds",
                        "CryColumn",
                        "Skill",
                        "FirstSkillTime"
                    ]
                },
                {
                    "name": "No"
                }
            ]
        },
        "MonsterSoulUpgradeConfig": {
            "type": "switch",
            "label": "魔魂升级配置",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "UpgradeCountMode",
                        "UpgradeSouls",
                        "RetentionGroup1",
                        "RetentionGroup2",
                        "RetentionGroup3"
                    ]
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}
