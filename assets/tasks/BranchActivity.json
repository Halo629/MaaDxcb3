{
	"task": [
		{
			"name": "SummerLotusPond",
			"label": "🪷夏夜荷塘",
			"entry": "BranchActivityStart",
			"group": ["activity_tasks"],
			"option": [
				"BranchActivitySoulTomb",
				"BranchActivityReforge"
			]
		},
		{
			"name": "OdeFulSecludedCorridor",
			"label": "🏮颂礼幽廊",
			"entry": "BranchActivityStart",
			"group": ["activity_tasks"],
			"option": [
				"BranchActivitySoulTomb",
				"BranchActivityReforge"
			]
		},
		{
			"name": "HoardGoldInSeclusion",
			"label": "❄️卧雪囤金",
			"entry": "BranchActivityStart",
			"group": ["activity_tasks"],
			"option": [
				"BranchActivitySoulTomb",
				"BranchActivityReforge"
			]
		}
	],
	"option": {
		"BranchActivitySoulTomb": {
			"type": "switch",
			"label": "挑战1次魂墓",
			"description":"会自动识别是否需要挑战，且进入战斗后会立即退出",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"AdjustSoulTombStartLevel": {
							"attach": {"target_level": "current"}
						},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"SoulTombEnable": true}
						},
						"BattleAI": {
							"attach": {"quit_immediately": true}
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"SoulTombEnable": false}
						}
					}
				}
			]
		},
		"BranchActivityReforge": {
			"type": "switch",
			"label": "装备重铸1次",
			"description":"会自动识别是否需要重铸。重铸时仅选择1号位人物装备，从头盔依次尝试，重铸满足次数后退出",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"ReforgeTaskStart":{"enabled":true},
						"FirstRoleEquipmentReforge": {"enabled": true},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"ReforgeEquipmentEnable": true}
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"ReforgeTaskStart":{"enabled":false},
						"ActivityCommonNotCompletedTaskEnable": {
							"attach": {"ReforgeEquipmentEnable": false}
						}
					}
				}
			]
		}
	}
}
